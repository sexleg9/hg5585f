#!/bin/sh
# 温度 / 光模块 / WAN 信息聚合
#
# 用法：
#   tempinfo            单行人类可读
#   tempinfo -j         JSON
#   tempinfo -s         极简
#
# 数据来源：
#   CPU  /sys/class/thermal/thermal_zone0/temp
#   WiFi /sys/class/ieee80211/phy*/hwmon*/temp1_input
#   PON  ponctl --device <pon> status --json 的 frontend 段
#   WAN  /sys/class/net/<wan>/statistics/{rx,tx}_bytes 两次采样求差

MODE="long"
case "$1" in
	-j|--json)  MODE="json" ;;
	-s|--short) MODE="short" ;;
esac

# ---------- WAN 实时速率（Mbps，两位小数，采样 1 秒） ----------
wan_rate() {
	dev="$1"
	[ -n "$dev" ] || { echo "0.00 0.00"; return; }
	r1=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null || echo 0)
	t1=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null || echo 0)
	sleep 1
	r2=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null || echo 0)
	t2=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null || echo 0)
	awk -v r1="$r1" -v r2="$r2" -v t1="$t1" -v t2="$t2" \
		'BEGIN{printf "%.2f %.2f\n", (r2-r1)*8/1000000, (t2-t1)*8/1000000}'
}

# ---------- WAN 设备探测 ----------
wan_dev=""
if [ -r /lib/functions/network.sh ]; then
	. /lib/functions/network.sh 2>/dev/null
	network_get_device wan_dev wan 2>/dev/null
fi
if [ -z "$wan_dev" ] && [ -r /proc/net/route ]; then
	wan_dev=$(awk '$2=="00000000" {print $1; exit}' /proc/net/route)
fi
if [ -z "$wan_dev" ]; then
	for d in /sys/class/net/pppoe-wan /sys/class/net/wan /sys/class/net/wwan; do
		[ -e "$d" ] || continue
		wan_dev=$(basename "$d")
		break
	done
fi

# ---------- CPU ----------
cpu=""
if [ -r /sys/class/thermal/thermal_zone0/temp ]; then
	cpu=$(awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone0/temp)
fi

# ---------- WiFi ----------
wifi=""
for f in /sys/class/ieee80211/phy*/hwmon*/temp1_input; do
	[ -r "$f" ] || continue
	t=$(awk '{printf "%.1f", $1/1000}' "$f")
	wifi="$wifi $t"
done
wifi=${wifi# }
# 只保留最高温度
[ -n "$wifi" ] && wifi=$(echo "$wifi" | tr ' ' '\n' | sort -rn | head -1)

# ---------- PON ----------
pon_dev=""
for d in /sys/class/net/pon*; do
	[ -e "$d" ] || continue
	pon_dev=$(basename "$d")
	break
done

pon_json=""
if [ -n "$pon_dev" ] && [ -x /usr/sbin/ponctl ]; then
	pon_json=$(/usr/sbin/ponctl --device "$pon_dev" status --json 2>/dev/null)
fi

jget() {
	[ -n "$pon_json" ] || return
	printf '%s' "$pon_json" | jsonfilter -e "@.frontend.$1" 2>/dev/null
}

pon_t=$(jget temperature_celsius)
pon_rx=$(jget rx_power_dbm)
pon_tx=$(jget tx_power_dbm)
pon_bias=$(jget tx_bias_ma)
pon_v=$(jget voltage_volts)

# ---------- 输出 ----------
if [ "$MODE" = "json" ]; then
	printf '{"cpu_c":%s' "${cpu:-null}"
	if [ -n "$wifi" ]; then
		printf ',"wifi_c":[%s]' "$wifi"
	else
		printf ',"wifi_c":null'
	fi
	if [ -n "$pon_t" ]; then
		printf ',"pon":{"device":"%s","temp_c":%s,"rx_power_dbm":%s,"tx_power_dbm":%s,"tx_bias_ma":%s,"voltage_v":%s}' \
			"$pon_dev" "${pon_t:-null}" "${pon_rx:-null}" "${pon_tx:-null}" \
			"${pon_bias:-null}" "${pon_v:-null}"
	else
		printf ',"pon":null'
	fi
	if [ -n "$wan_dev" ]; then
		wan_r=$(wan_rate "$wan_dev")
		wan_rx_mbps=$(echo "$wan_r" | awk '{print $1}')
		wan_tx_mbps=$(echo "$wan_r" | awk '{print $2}')
		printf ',"wan":{"device":"%s","rx_mbps":%s,"tx_mbps":%s}' \
			"$wan_dev" "${wan_rx_mbps:-0}" "${wan_tx_mbps:-0}"
	else
		printf ',"wan":null'
	fi
	printf '}\n'
	exit 0
fi

if [ "$MODE" = "short" ]; then
	out=""
	[ -n "$cpu" ]   && out="CPU: ${cpu}°C"
	[ -n "$pon_t" ] && out="${out:+$out, }PON: $(awk -v v="$pon_t" 'BEGIN{printf "%.1f", v}')°C"
	[ -n "$wifi" ]  && out="${out:+$out, }WiFi: ${wifi}°C"
	if [ -n "$wan_dev" ]; then
		wan_r=$(wan_rate "$wan_dev")
		wan_rx_mbps=$(echo "$wan_r" | awk '{print $1}')
		wan_tx_mbps=$(echo "$wan_r" | awk '{print $2}')
		out="${out:+$out, }WAN: ↓${wan_rx_mbps}M ↑${wan_tx_mbps}M"
	fi
	[ -n "$out" ] || out="No temperature info"
	printf '%s' "$out"
	exit 0
fi

# 长格式
out=""
[ -n "$cpu" ] && out="CPU: ${cpu}°C"

if [ -n "$pon_t" ]; then
	p=$(awk -v v="$pon_t" 'BEGIN{printf "%.1f°C", v}')
	[ -n "$pon_rx" ] && p="$p 收$(awk -v v="$pon_rx" 'BEGIN{printf "%+.1f", v}')dBm"
	[ -n "$pon_tx" ] && p="$p 发$(awk -v v="$pon_tx" 'BEGIN{printf "%.1f", v}')dBm"
	out="${out:+$out | }PON: $p"
fi

[ -n "$wifi" ] && out="${out:+$out | }WiFi: ${wifi}°C"

if [ -n "$wan_dev" ]; then
	wan_r=$(wan_rate "$wan_dev")
	wan_rx_mbps=$(echo "$wan_r" | awk '{print $1}')
	wan_tx_mbps=$(echo "$wan_r" | awk '{print $2}')
	out="${out:+$out | }WAN: ↓${wan_rx_mbps}M ↑${wan_tx_mbps}M"
fi

[ -n "$out" ] || out="No temperature info"
printf '%s' "$out"
